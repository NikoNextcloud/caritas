{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
      }
    },

    "requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdBy", "assignedTo"]
    },

    "beneficiaries": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "employers": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}