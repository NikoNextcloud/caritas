rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function admin() {
      return signedIn() && role() == 'admin';
    }

    function ownedByUser(data) {
      return signedIn() && (
        data.createdByUid == request.auth.uid ||
        data.assignedToUid == request.auth.uid
      );
    }

    function canCreateOwned() {
      return admin() || (signedIn() && request.resource.data.createdByUid == request.auth.uid);
    }

    function canUpdateOwned() {
      return admin() || (
        ownedByUser(resource.data) &&
        request.resource.data.createdByUid == resource.data.createdByUid
      );
    }

    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create, delete: if admin();
      allow update: if admin() || (
        signedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline'])
      );
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if admin() || (signedIn() && request.auth.uid == uid);
    }

    match /beneficiaryRequests/{id} {
      allow read: if admin() || ownedByUser(resource.data);
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if admin();
    }

    match /beneficiaries/{id} {
      allow read: if signedIn();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if admin();
    }

    match /tasks/{id} {
      allow read: if admin() || ownedByUser(resource.data);
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if admin();
    }

    match /schedule/{id} {
      allow read: if signedIn();
      allow create: if canCreateOwned();
      allow update: if signedIn() &&
        request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if admin();
    }

    match /employers/{id} {
      allow read: if signedIn();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if admin();
    }

    match /volunteers/{id} {
      allow read: if signedIn();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if admin();
    }

    match /donors/{id} {
      allow read: if signedIn();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if admin();
    }

    match /notifications/{id} {
      allow read: if admin() || ownedByUser(resource.data);
      allow create: if canCreateOwned();
      allow update: if admin() || ownedByUser(resource.data);
      allow delete: if admin();
    }

    match /auditLogs/{id} {
      allow read: if admin();
      allow create: if signedIn() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorRole == role() &&
        request.resource.data.keys().hasAll([
          'actorUid', 'actorName', 'actorRole', 'action',
          'entityType', 'description', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'actorUid', 'actorName', 'actorRole', 'action',
          'entityType', 'entityId', 'description', 'path',
          'changedFields', 'createdAt'
        ]);
      allow update: if false;
      allow delete: if admin();
    }
  }
}
